require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
# The LevelPlay (ironSource) SDK is a static binary, so the pods must be linked statically too (the plugin's sync script
# is meant to patch this line but its pattern never matches, so it is set here).
use_frameworks! :linkage => :static

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorLevelplayAds', :path => '../../node_modules/capacitor-levelplay-ads'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # LEVELPLAY-ADAPTERS:BEGIN (generated by levelplay-manifest.js)
  pod 'IronSourceUnityAdsAdapter'
  # LEVELPLAY-ADAPTERS:END
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Pod resource bundles are not signed by the app's signing identity; without this Xcode asks for a team for each of them.
  installer.pods_project.targets.each do |target|
    next unless target.respond_to?(:product_type) && target.product_type == 'com.apple.product-type.bundle'
    target.build_configurations.each { |config| config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO' }
  end
end
